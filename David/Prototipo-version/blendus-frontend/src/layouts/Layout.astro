---
import '../styles/global.css';

interface Props {
  title?: string;
  activePage?: 'home' | 'explore' | 'create' | 'profile' | 'login' | 'register';
}
const { title = 'BlendUs', activePage } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content="BlendUs — The social network for smoothie lovers. Share recipes, discover new blends and connect with the community.">
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title} — BlendUs</title>
  </head>
  <body>
    <nav>
      <div class="nav-logo">
        <a href="/">
          <div class="brand">
            <svg width="800px" height="800px" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path fill-rule="evenodd" clip-rule="evenodd" d="M13.4598 4.6821C11.999 4.10603 10.1634 4.03624 8.44724 4.89439C6.74737 5.74439 5.63985 7.23414 4.94838 9.30462C4.24917 11.3983 3.99976 14.0213 3.99976 16.9999C3.99976 17.6747 4.34721 18.4332 4.95687 19.0428C5.56652 19.6525 6.32499 20 6.99976 20C9.8827 20 12.505 19.7575 14.6233 19.06C16.7233 18.3687 18.253 17.258 19.1056 15.5528C19.9679 13.8281 19.9189 11.9841 19.3567 10.5262C19.108 9.88118 18.7767 9.34894 18.4078 8.94001L18.9806 11.8039C19.0889 12.3454 18.7377 12.8723 18.1961 12.9806C17.6546 13.0889 17.1277 12.7377 17.0194 12.1961L16.6363 10.2806L15.9138 11.9061C15.6895 12.4108 15.0985 12.6381 14.5939 12.4138C14.0892 12.1895 13.8619 11.5985 14.0862 11.0939L15.0302 8.96981L12.9061 9.91382C12.4014 10.1381 11.8105 9.91081 11.5862 9.40612C11.3619 8.90143 11.5892 8.31048 12.0939 8.08618L13.7195 7.36372L11.8039 6.98058C11.2623 6.87225 10.9111 6.34542 11.0194 5.80387C11.1277 5.26231 11.6546 4.9111 12.1961 5.01942L14.9778 5.57579C14.5776 5.23353 14.0688 4.92224 13.4598 4.6821ZM18.7737 6.64046C19.8668 7.33898 20.7216 8.50708 21.2227 9.80662C21.9674 11.7378 22.0321 14.1719 20.8944 16.4472C19.7338 18.7684 17.6849 20.1577 15.2488 20.9597C12.8311 21.7557 9.95984 22 6.99976 22C5.67452 22 4.43299 21.3474 3.54265 20.4571C2.6523 19.5667 1.99976 18.3252 1.99976 16.9999C1.99976 13.9461 2.25047 11.0693 3.05138 8.67108C3.86003 6.24973 5.25264 4.25571 7.55276 3.10556C9.83658 1.96357 12.2699 2.06296 14.1936 2.82154C15.4792 3.32855 16.6391 4.17819 17.3412 5.24451L18.2926 4.29301C18.6831 3.90247 19.3163 3.90243 19.7068 4.29293C20.0974 4.68343 20.0974 5.31659 19.7069 5.70714L18.7737 6.64046Z" fill="#ffffff"/>
            </svg>
          </div>
          <h1>BlendUs</h1>
        </a>
      </div>
      <div class="nav-menu">
        <a href="/" class={activePage === 'home' ? 'active' : ''}>
          <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M9 21H4C3.44772 21 3 20.5523 3 20V12.4142C3 12.149 3.10536 11.8946 3.29289 11.7071L11.2929 3.70711C11.6834 3.31658 12.3166 3.31658 12.7071 3.70711L20.7071 11.7071C20.8946 11.8946 21 12.149 21 12.4142V20C21 20.5523 20.5523 21 20 21H15M9 21H15M9 21V15C9 14.4477 9.44772 14 10 14H14C14.5523 14 15 14.4477 15 15V21" stroke="#6b7280" stroke-width="2" stroke-linejoin="round"/>
          </svg>
          Home
        </a>
        <a href="/explore" class={activePage === 'explore' ? 'active' : ''}>
          <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M19.9604 11.4802C19.9604 13.8094 19.0227 15.9176 17.5019 17.4512C15.9812 18.9848 13.8688 19.9604 11.4802 19.9604C6.79672 19.9604 3 16.1637 3 11.4802C3 6.79672 6.79672 3 11.4802 3C16.1637 3 19.9604 6.79672 19.9604 11.4802Z" stroke="#6b7280" stroke-width="2"/>
            <path d="M18.1553 18.1553L21.8871 21.8871" stroke="#6b7280" stroke-width="2" stroke-linecap="round"/>
          </svg>
          Explore
        </a>
        <a href="/create" class={activePage === 'create' ? 'active' : ''}>
          <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M15 12H12M12 12H9M12 12V9M12 12V15M17 21H7C4.79086 21 3 19.2091 3 17V7C3 4.79086 4.79086 3 7 3H17C19.2091 3 21 4.79086 21 7V17C21 19.2091 19.2091 21 17 21Z" stroke="#6b7280" stroke-width="2" stroke-linecap="round"/>
          </svg>
          Create
        </a>
        <div id="nav-auth-slot" style="display: flex; align-items: center; gap: 1rem;"></div>
      </div>
    </nav>

    <slot />

    <script>
      import { initAuth, $isLoggedIn, $user, clearAuth } from '../stores/authStore';
      import { api } from '../lib/api';
      initAuth();

      const slot = document.getElementById('nav-auth-slot');
      if (slot) {
        const render = () => {
          const loggedIn = $isLoggedIn.get();
          const user = $user.get();
          if (loggedIn && user) {
            slot.innerHTML = `
              <a href="/profile/${user.id}" style="gap:.4rem">
                <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" style="width:22px;height:22px">
                  <path d="M20 21V19a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2" stroke="#6b7280" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                  <circle cx="12" cy="7" r="4" stroke="#6b7280" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" fill="none"/>
                </svg>
                ${user.name.split(' ')[0]}
              </a>
              <button id="logout-btn" class="btn btn-ghost" style="font-size:.85rem;padding:.4rem .9rem">Logout</button>
            `;
            document.getElementById('logout-btn')?.addEventListener('click', async () => {
              try { await api.logout(); } catch {}
              clearAuth();
              window.location.href = '/login';
            });
          } else {
            slot.innerHTML = `<a href="/login" class="btn" style="border-radius:100px;font-size:.9rem">Sign In</a>`;
          }
        };
        render();
        $isLoggedIn.subscribe(render);
      }
    </script>
  </body>
</html>
