---
import '../styles/global.css';

interface Props {
  title?: string;
}
const { title = 'BlendUs' } = Astro.props;

const backgrounds = ['/assets/login-1.jpg', '/assets/login-2.jpg', '/assets/login-3.jpg'];
const randomBg = backgrounds[Math.floor(Math.random() * backgrounds.length)];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link href="https://fonts.googleapis.com/css2?family=Alexandria:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <title>{title} — BlendUs</title>
    <style>
      body {
        margin: 0;
        display: flex;
        min-height: 100vh;
        background-color: #fdfdfd;
        font-family: 'Alexandria', sans-serif;
      }
      .auth-image-side {
        flex: 1.1;
        display: none;
        background-size: cover;
        background-position: center;
        border-right: 1px solid var(--gray-100);
      }
      .auth-form-side {
        flex: 1;
        display: flex;
        flex-direction: column;
        justify-content: center;
        padding: 2rem clamp(1rem, 5vw, 6rem);
        overflow-y: auto;
        background-color: #fdfdfd;
      }
      @media (min-width: 900px) {
        .auth-image-side {
          display: block;
        }
      }
    </style>
  </head>
  <body>
    <div class="auth-image-side" style={`background-image: url('${randomBg}')`}>
    </div>

    <div class="auth-form-side">
      <slot />
    </div>
  </body>
</html>
